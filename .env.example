# Form email delivery. Placeholders only: never commit real values.
# Option A (recommended): SMTP of the mailbox that owns info@rudrix.co.in (Hostinger, GoDaddy, Zoho, Google Workspace...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rudrix.co.in
SMTP_PASS=your_mailbox_or_app_password_here
EMAIL_FROM=Rudrix Website <info@rudrix.co.in>
# Where inquiry notifications are delivered (defaults to info@rudrix.co.in)
CONTACT_RECIPIENT=info@rudrix.co.in

# Option B: Resend instead of SMTP (leave the SMTP_* lines out)
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_AUDIENCE_ID=   # optional: stores newsletter subscribers

NEXT_PUBLIC_SITE_URL=https://rudrix.co.in

# Floating WhatsApp button: business number, digits only with country code (no +, spaces or brackets). Button stays hidden until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=919888792614
